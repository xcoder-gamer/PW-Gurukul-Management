rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- GLOBAL SAFETY NET ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- SHARED HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Auth lookup with caching
    function getUserData() {
      let emailLower = request.auth.token.email.lower();
      let emailPath = /databases/$(database)/documents/user_roles/$(emailLower);
      return exists(emailPath) ? get(emailPath).data : null;
    }

    function getRole() {
      let data = getUserData();
      return data != null ? data.get('role', 'guest').lower() : 'guest';
    }

    function isAdmin() {
      let role = getRole();
      let adminEmails = ["devansh.sharma@pw.live", "deepayan.nayak@pw.live", "gurukul.ops@pw.live"];
      return isSignedIn() && (role == 'admin' || request.auth.token.email.lower() in adminEmails);
    }

    function isCentralTeam() {
      let role = getRole();
      return isSignedIn() && (role == 'central_team' || role == 'central' || role == 'operator');
    }

    function isCenterLevel() {
      let role = getRole();
      return isSignedIn() && (role == 'center_level' || role == 'center');
    }

    function isTeacher() {
      return isSignedIn() && getRole() == 'teacher';
    }

    function isOperator() {
      return isSignedIn() && getRole() == 'operator';
    }

    function canDelete() {
      return isAdmin() || isOperator() || isCentralTeam();
    }

    function getUserCenterId() {
      let data = getUserData();
      return data.get('centerId', null);
    }

    // Teacher check
    function isMappingExists(teacherId, batchId) {
      let mappingId = teacherId + "_" + batchId;
      return exists(/databases/$(database)/documents/mappings/$(mappingId));
    }

    // --- ENTITY VALIDATIONS ---
    function isValidBatch(data) {
      return data.batchName is string && data.batchName.size() <= 200
        && data.programId is string && data.programId.size() <= 128
        && data.centerId is string && data.centerId.size() <= 128;
    }

    function isValidStudent(data) {
      return data.name is string && data.name.size() <= 200
        && data.regNo is string && data.regNo.size() <= 64
        && data.batchId is string && data.batchId.size() <= 128
        && (data.get('email', '') is string && data.get('email', '').size() <= 256)
        && (data.get('phone', '') is string && data.get('phone', '').size() <= 20);
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['studentId', 'batchId', 'date', 'status'])
        && data.studentId is string && data.studentId.size() <= 128
        && data.batchId is string && data.batchId.size() <= 128
        && data.date is string && data.date.size() <= 20
        && data.status in ['Present', 'Absent'];
    }

    function isValidTest(data) {
      return data.keys().hasAll(['name', 'date', 'batchIds', 'totalQuestions', 'answerKey'])
        && data.name is string && data.name.size() <= 200
        && data.batchIds is list && data.batchIds.size() <= 50
        && data.totalQuestions is number
        && data.answerKey is map;
    }

    function isValidResult(data) {
      return data.keys().hasAll(['testId', 'regNo', 'score', 'accuracy'])
        && data.testId is string && data.testId.size() <= 128
        && data.regNo is string && data.regNo.size() <= 64
        && data.score is number && data.accuracy is number;
    }

    // --- COLLECTION RULES ---

    match /user_roles/{email} {
      allow read: if isSignedIn() && (request.auth.token.email.lower() == email.lower() || isAdmin() || isCentralTeam());
      allow write: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || isOperator()) && isValidId(programId);
    }

    match /centers/{centerId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || isOperator() || isCentralTeam()) && isValidId(centerId);
    }

    match /batches/{batchId} {
      allow read: if isAdmin() || isCentralTeam() 
        || (isCenterLevel() && resource.data.centerId == getUserCenterId())
        || (isTeacher() && isMappingExists(request.auth.token.email.lower(), batchId));
      allow create: if (isAdmin() || isOperator() || isCentralTeam()) && isValidId(batchId) && isValidBatch(incoming());
      allow update: if (isAdmin() || isOperator() || isCentralTeam()) && isValidBatch(incoming());
      allow delete: if canDelete();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isCentralTeam()
        || (isCenterLevel() && resource.data.centerId == getUserCenterId())
        || (isTeacher() && isMappingExists(request.auth.token.email.lower(), resource.data.batchId));
      allow create: if (isAdmin() || isOperator() || isCentralTeam()) && isValidId(studentId) && isValidStudent(incoming());
      allow update: if (isAdmin() || isOperator() || isCentralTeam()) && isValidStudent(incoming());
      allow delete: if canDelete();
    }

    match /tests/{testId} {
        allow read: if isAdmin() || isCentralTeam() || isCenterLevel() || isTeacher();
        allow create: if (isAdmin() || isOperator() || isCentralTeam()) && isValidId(testId) && isValidTest(incoming());
        allow update: if (isAdmin() || isOperator() || isCentralTeam()) && isValidTest(incoming());
        allow delete: if canDelete();
    }

    match /results/{resultId} {
      allow read: if isAdmin() || isCentralTeam()
        || (isCenterLevel() && get(/databases/$(database)/documents/students/$(resource.data.regNo)).data.centerId == getUserCenterId())
        || (isTeacher() && isMappingExists(request.auth.token.email.lower(), get(/databases/$(database)/documents/students/$(resource.data.regNo)).data.batchId));
      allow create: if (isAdmin() || isOperator() || isCentralTeam()) && isValidId(resultId) && isValidResult(incoming());
      allow update: if (isAdmin() || isOperator() || isCentralTeam()) && isValidResult(incoming());
      allow delete: if canDelete();
    }

    match /attendance/{id} {
      allow read: if isAdmin() || isCentralTeam()
        || (isCenterLevel() && resource.data.centerId == getUserCenterId())
        || (isTeacher() && isMappingExists(request.auth.token.email.lower(), resource.data.batchId));
      allow create: if (isAdmin() || isOperator()) && isValidId(id) && isValidAttendance(incoming())
        || (isTeacher() && isMappingExists(request.auth.token.email.lower(), incoming().batchId) && isValidAttendance(incoming()));
      allow update: if (isAdmin() || isOperator()) && isValidAttendance(incoming())
        || (isTeacher() && isMappingExists(request.auth.token.email.lower(), existing().batchId) && isValidAttendance(incoming()));
    }

    match /teachers/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /mappings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    match /result_updated/{resultId} {
      allow read: if isSignedIn();
      allow create: if (isAdmin() || isOperator() || isCentralTeam()) && isValidId(resultId) && isValidResult(incoming());
      allow update: if (isAdmin() || isOperator() || isCentralTeam()) && isValidResult(incoming());
      allow delete: if (isAdmin() || isOperator() || isCentralTeam());
    }

    match /qbgLibrary/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOperator();
    }

    match /qbgMaster/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOperator();
    }

    match /testPatterns/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
